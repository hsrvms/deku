# Deku configuration
# Copy this file to .env and fill in your values.

# OpenAI-compatible provider endpoint
DEKU_PROVIDER_ENDPOINT=https://api.openai.com/v1

# API key for the provider
DEKU_PROVIDER_API_KEY=sk-your-key-here

# Model name (e.g. gpt-4, qwen-2.5-coder, claude-sonnet-4-20250514)
DEKU_PROVIDER_MODEL=gpt-4

# Agent Commit mode: off (default), ask, or on
DEKU_AGENT_COMMITS=off