# Deku configuration values
# Copy this file to ~/.deku/.env and fill in your values.
#
# Deku auto-loads ~/.deku/.env and resolves ${VAR} and ${VAR:-default}
# placeholders in ~/.deku/settings.json, ~/.deku/auth.json, and
# ~/.deku/models.json from it. The real process environment always wins over
# this file. A placeholder that references an unset variable with no default
# fails startup with an explicit error naming the variable — except for
# Authentication API keys, which are left empty so a missing secret never
# blocks the other Providers.

# Example: an Authentication API key referenced as ${OPENAI_API_KEY} in
# ~/.deku/auth.json
OPENAI_API_KEY=sk-your-key-here

# Example: a Provider endpoint referenced as ${OPENAI_ENDPOINT} in
# ~/.deku/models.json
OPENAI_ENDPOINT=https://api.openai.com/v1

# Agent Commit mode: off (default), ask, or on. This is the
# environment-as-source override for agent_commits.mode in settings.json.
DEKU_AGENT_COMMITS=off

# Benchmark-only: the v0 acceptance benchmark (agent/benchmark_test.go) reads
# the DEKU_PROVIDER_* variables when DEKU_BENCHMARK=1. The interactive CLI
# does not read them — Provider configuration lives only in the module files.
#   DEKU_BENCHMARK=1 go test ./agent/ -run TestV0Benchmark -v
DEKU_BENCHMARK=
DEKU_PROVIDER_ENDPOINT=https://api.openai.com/v1
DEKU_PROVIDER_API_KEY=sk-your-key-here
DEKU_PROVIDER_MODEL=gpt-4
